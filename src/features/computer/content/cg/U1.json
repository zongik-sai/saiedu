{
  "match": {
    "U1-t1": {
      "pairs": [
        {
          "term": "자료(Data)",
          "desc": "관찰·측정으로 얻은, 아직 가공하지 않은 값이나 사실"
        },
        {
          "term": "정보(Information)",
          "desc": "처리·가공을 거쳐 의사결정에 쓸 수 있게 만든 결과"
        },
        {
          "term": "정보 처리",
          "desc": "가공 전 값을 쓸모 있는 결과로 바꾸는 과정으로, 컴퓨터가 빠르고 정확하게 해 줌"
        }
      ],
      "distractor": "정보화"
    },
    "U1-t2": {
      "pairs": [
        {
          "term": "정보 격차",
          "desc": "정보가 특정 계층에 몰리면서 계층 사이에 벌어지는 차이"
        },
        {
          "term": "VDT 증후군",
          "desc": "화면을 오래 보며 작업해 생기는 눈의 피로, 목·어깨·손목 통증"
        },
        {
          "term": "테크노스트레스",
          "desc": "정보기술의 도입·빠른 변화와 업무 환경 변화에 적응하며 겪는 심리적 부담"
        }
      ],
      "distractor": "개인정보 침해"
    },
    "U1-t3": {
      "pairs": [
        {
          "term": "Bit",
          "desc": "0 또는 1 하나를 나타내는 정보 표현의 최소 단위"
        },
        {
          "term": "Byte",
          "desc": "8개의 비트로 이루어지며, 문자 하나를 표현하는 기본 단위"
        },
        {
          "term": "Word",
          "desc": "CPU가 한 번에 처리할 수 있는 명령·데이터의 단위"
        }
      ],
      "distractor": "Nibble"
    },
    "U1-t4": {
      "pairs": [
        {
          "term": "Record",
          "desc": "관련된 여러 항목을 묶은 한 건의 자료(예: 한 학생의 학번·이름·점수)"
        },
        {
          "term": "File",
          "desc": "같은 종류의 '한 건 자료'를 여러 개 모은 것(예: 2학년 전체 성적 목록)"
        },
        {
          "term": "Database",
          "desc": "관련 데이터를 체계적으로 모아 여러 사람이 공유·관리하게 한 집합"
        }
      ],
      "distractor": "Field"
    },
    "U1-t5": {
      "pairs": [
        {
          "term": "BCD",
          "desc": "10진수 한 자리를 4Bit 2진수(8421 가중치)로 나타내는 코드"
        },
        {
          "term": "ASCII",
          "desc": "7Bit로 128가지 문자를 표현하며 PC·데이터 통신에 쓰이는 미국 표준"
        },
        {
          "term": "EBCDIC",
          "desc": "8Bit로 256가지 문자를 표현하며 IBM 대형 컴퓨터 계열에서 쓰인 코드"
        }
      ],
      "distractor": "Unicode"
    },
    "U1-t6": {
      "pairs": [
        {
          "term": "코드 포인트",
          "desc": "Unicode가 문자마다 붙여 주는 고유한 번호(예: '가'는 U+AC00)"
        },
        {
          "term": "디코딩",
          "desc": "저장된 Byte를 다시 문자로 되돌리는 과정"
        },
        {
          "term": "UTF-8",
          "desc": "문자 하나를 1~4Byte로 쓰는 가변 길이 방식, 영문·숫자는 ASCII와 같음"
        }
      ],
      "distractor": "UTF-16"
    },
    "U1-t7": {
      "pairs": [
        {
          "term": "Parity Bit",
          "desc": "전송 오류를 검사하려고 원래 데이터에 덧붙이는 1Bit"
        },
        {
          "term": "Odd Parity",
          "desc": "덧붙인 검사 비트까지 포함해 1의 개수를 홀수로 맞추는 방식"
        },
        {
          "term": "Even Parity",
          "desc": "덧붙인 검사 비트까지 포함해 1의 개수를 짝수로 맞추는 방식"
        }
      ],
      "distractor": "해밍 코드"
    },
    "U1-t8": {
      "pairs": [
        {
          "term": "해밍 코드",
          "desc": "여러 검사용 비트로 1Bit 오류의 위치를 찾아 스스로 고칠 수 있게 한 코드"
        },
        {
          "term": "전진 오류 수정",
          "desc": "받는 쪽에서 오류를 직접 고치는 방식으로, 영문 약어는 FEC"
        },
        {
          "term": "패리티 비트",
          "desc": "1, 2, 4, 8번째(2의 거듭제곱) 위치에 넣는 검사용 비트"
        }
      ],
      "distractor": "Odd Parity"
    },
    "U1-t9": {
      "pairs": [
        {
          "term": "2진수",
          "desc": "0과 1만 쓰며, 컴퓨터가 내부적으로 동작할 때 쓰는 진법"
        },
        {
          "term": "8진수",
          "desc": "0~7을 쓰며, 2진 3자리를 1자리로 묶어 나타내는 진법"
        },
        {
          "term": "16진수",
          "desc": "0~9와 A~F를 쓰며, 메모리 주소·MAC 주소·색상 코드에 자주 쓰는 진법"
        }
      ],
      "distractor": "10진수"
    },
    "U1-t10": {
      "pairs": [
        {
          "term": "부호 비트",
          "desc": "맨 앞 비트로, 0이면 양수, 1이면 음수를 나타냄"
        },
        {
          "term": "1의 보수",
          "desc": "모든 비트를 뒤집기만 한 표현으로, 0이 +0과 -0 두 가지가 생김"
        },
        {
          "term": "2의 보수",
          "desc": "모든 비트를 뒤집고 1을 더한 표현으로, 0이 하나뿐임"
        }
      ],
      "distractor": "Parity Bit"
    },
    "U1-t11": {
      "pairs": [
        {
          "term": "KB",
          "desc": "2¹⁰Byte(=1,024Byte)로, 약 1천 Byte에 해당하는 단위"
        },
        {
          "term": "GB",
          "desc": "2³⁰Byte로, 약 10억 Byte에 해당하는 단위"
        },
        {
          "term": "TB",
          "desc": "2⁴⁰Byte로, 약 1조 Byte에 해당하는 단위"
        }
      ],
      "distractor": "MB"
    },
    "U1-t12": {
      "pairs": [
        {
          "term": "마이크로초",
          "desc": "10⁻⁶초에 해당하는 시간 단위로, 기호는 μs"
        },
        {
          "term": "나노초",
          "desc": "10⁻⁹초에 해당하는 시간 단위로, 기호는 ns"
        },
        {
          "term": "Hz",
          "desc": "1초에 몇 번 동작하는지로 처리 속도를 나타내는 단위"
        }
      ],
      "distractor": "피코초"
    },
    "U1-t13": {
      "pairs": [
        {
          "term": "10진 단위",
          "desc": "1,000배씩 커지는 계산 기준으로, 디스크 제조사가 용량 표기에 사용"
        },
        {
          "term": "2진 단위",
          "desc": "1,024배씩 커지는 계산 기준으로, Windows가 용량 계산에 사용"
        },
        {
          "term": "GiB",
          "desc": "2³⁰Byte를 GB와 구분해 정확히 나타내려고 IEC가 정한 표기"
        }
      ],
      "distractor": "MiB"
    },
    "U1-t14": {
      "pairs": [
        {
          "term": "ECC 메모리",
          "desc": "64Bit마다 검사 비트 8Bit를 더해 1Bit 오류를 자동으로 고치는 메모리"
        },
        {
          "term": "On-die ECC",
          "desc": "DDR5의 메모리 칩 내부에서 오류를 고치는 기능"
        },
        {
          "term": "MAC 주소",
          "desc": "48Bit를 16진수 12자리로 나타내어 표기하는 주소"
        }
      ],
      "distractor": "IPv4 주소"
    }
  },
  "mid": []
}
